# Copy this file to .env and adjust the values. .env is git-ignored - never commit it.
# docker compose reads .env automatically.

# --- database (the compose stack already provides a Postgres service) ---
DB_URL=jdbc:postgresql://localhost:5432/developershub
DB_USERNAME=devuser
DB_PASSWORD=devpass

# --- auth ---
# HMAC key for signing JWTs. Must be at least 32 bytes.
# Generate one with:  openssl rand -base64 48
# If left empty the API generates a random key at every startup, which invalidates
# all tokens whenever the container restarts.
JWT_SECRET=
JWT_EXPIRATION_MS=1800000
REFRESH_TOKEN_EXPIRATION_DAYS=7

# One-time token that lets the first account claim the ADMIN role through
# POST /api/auth/admin/bootstrap. Clear it once the admin exists.
ADMIN_SETUP_TOKEN=

# --- browser access ---
# Comma-separated origins allowed to call the API from a browser.
# Leave empty to disable CORS entirely.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- rate limits (per client IP) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_BOOTSTRAP_MAX=3
